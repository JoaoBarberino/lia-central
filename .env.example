# Copie este arquivo para .env e preencha os valores. O .env NÃO vai para o Git.

# --- Fonte dos documentos ---
# "drive" para a pasta do Google Drive; "local" para uma pasta do computador (desenvolvimento/testes)
SOURCE_MODE=drive
# Usado só quando SOURCE_MODE=local
LOCAL_FOLDER=./amostra

# --- Google Drive (OAuth de aplicação web) ---
GOOGLE_CLIENT_ID=<SEU_CLIENT_ID_WEB>
GOOGLE_CLIENT_SECRET=<SEU_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
DRIVE_TEST_FOLDER_ID=<ID_DA_SUA_PASTA_DE_TESTE>

# --- IA ---
# "gemini" usa a API do Gemini; "off" desliga a extração por IA (a sincronização continua funcionando)
LLM_PROVIDER=gemini
GEMINI_API_KEY=<SUA_CHAVE_DO_AI_STUDIO>
GEMINI_MODEL=gemini-3.6-flash
# Reservas, em ordem, se o principal estiver sobrecarregado (503) ou sem cota (429). Separe por vírgula.
# Rode `python scripts/testar_gemini.py` para ver quais modelos respondem para a sua chave.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-latest
# Modelos das perguntas do "Comece aqui" (rápidos primeiro; opcional)
GEMINI_QA_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash

# --- Avisos no Discord (opcional) ---
# Endereço do webhook de um canal (Configurações do canal > Integrações > Webhooks). É secreto: fica só aqui.
DISCORD_WEBHOOK_URL=
# Endereço do site usado nos links dos avisos
APP_BASE_URL=http://localhost:8000

# --- Aplicação ---
# Chave para assinar o cookie de sessão. Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=<GERE_UMA_CHAVE_ALEATORIA>
# Intervalo da sincronização automática, em segundos (o case exige detecção em até 15 min)
SYNC_INTERVAL_SECONDS=180
DATABASE_PATH=./data/central.db
